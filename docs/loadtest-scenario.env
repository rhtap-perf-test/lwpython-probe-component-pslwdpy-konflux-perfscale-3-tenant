# Draft loadtest scenario for KONFLUX-15401 / LWPython (lightwell-dev).
# Install on Jenkins as: load-test-scenario.LWPython
# Or export these vars before running loadtest/ci-scripts/run-probe/run.sh

CLUSTER=lightwell-dev
NAMESPACE=konflux-perfscale-3-tenant
RUN_PREFIX=lwdpy
COMPONENT_REPO=https://github.com/thanujdesu11/lwpython-probe-component
COMPONENT_REPO_REVISION=main
FORK_TARGET=thanujdesu11
PIPELINE_REPO_TEMPLATING=true
PIPELINE_REPO_TEMPLATING_SOURCE=https://github.com/rhtap-perf-test/konflux-probe-test-templates
PIPELINE_REPO_TEMPLATING_SOURCE_DIR=python-wheel-build/
TEST_SCENARIO_GIT_URL=
TEST_SCENARIO_PATH_IN_REPO=
WAIT_INTEGRATION_TESTS=false
RELEASE_POLICY=
WAIT_RELEASE=false
WAIT_PIPELINES=true
CONCURRENCY=1
JOURNEY_REPEATS=1
APPLICATIONS_COUNT=1
COMPONENTS_COUNT=1
PURGE=true
OCI_STORAGE=quay.io/rhtap-perf-test/perf-release-service-trusted-artifacts-stage
QUAY_REPO=redhat-user-workloads-stage
LOGGING_LEVEL=debug
